<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Refreshes the portfolio's "Built with agents" counts every day at 03:30.
  Replace __SCRIPT__ with the absolute path of scripts/refresh-agent-usage.sh and __HOME__
  with your home directory, save as ~/Library/LaunchAgents/dev.db25.agent-usage.plist, then:
    launchctl bootstrap gui/$UID ~/Library/LaunchAgents/dev.db25.agent-usage.plist
  Remove with: launchctl bootout gui/$UID/dev.db25.agent-usage
  A Mac that was asleep at 03:30 runs it at the next wake.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.db25.agent-usage</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__SCRIPT__</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/portfolio-agent-usage.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/portfolio-agent-usage.log</string>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
